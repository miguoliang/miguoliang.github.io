---
import { SEO } from 'astro-seo';

type TocItem = { text: string; slug: string };
const {
	toc = [] as TocItem[],
	title,
	description,
	image,
	pubDate,
	updatedDate,
	author,
	jsonLd,
	wide = false,
	noindex = false,
} = Astro.props;

const isHomePage = Astro.url.pathname === '/';
const isArticle = Boolean(pubDate);

const siteName = 'AI 网摘';
const profileDescription =
	'精选 AI 应用技巧与行业趋势。每日日刊，不含学术论文。';
const slogan = '应用技巧 · 行业趋势';

const seoTitle = title || (isHomePage ? `${siteName} | 应用技巧与行业趋势` : siteName);
const seoDescription = description || profileDescription;
const canonical = Astro.url.href;
const siteUrl = Astro.site || new URL(Astro.url.pathname, Astro.url.origin).origin;
const ogImage = image || new URL('/og-image.png', siteUrl).href;
const ogImageAlt = `${siteName} — ${slogan}`;

const defaultJsonLd = isHomePage
	? {
			'@context': 'https://schema.org',
			'@type': 'WebSite',
			name: siteName,
			description: profileDescription,
			url: siteUrl,
			inLanguage: 'zh-CN',
			potentialAction: {
				'@type': 'SearchAction',
				target: `${siteUrl}/search?q={search_term_string}`,
				'query-input': 'required name=search_term_string',
			},
		}
	: undefined;

const structuredData = jsonLd || defaultJsonLd;
---
<!doctype html>
<html lang="zh-Hans">
	<head>
		<script is:inline>
			(function() {
				try {
					const theme =
						localStorage.getItem('theme') ||
						(window.matchMedia &&
						window.matchMedia('(prefers-color-scheme: dark)').matches
							? 'dark'
							: 'light');
					document.documentElement.setAttribute('data-theme', theme);
				} catch (e) {
					document.documentElement.setAttribute('data-theme', 'light');
				}
			})();
		</script>
		<style is:inline>
			html:not([data-theme]) {
				background-color: #f4f3ef;
			}
			html[data-theme='dark'] {
				background-color: #1e1e1c;
			}
			html[data-theme='light'] {
				background-color: #f4f3ef;
			}
		</style>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link
			rel="alternate"
			type="application/rss+xml"
			title="AI 网摘 RSS"
			href="/rss.xml"
		/>
		<SEO
			title={seoTitle}
			description={seoDescription}
			canonical={canonical}
			noindex={noindex}
			twitter={{
				card: 'summary_large_image',
				title: seoTitle,
				description: seoDescription,
				image: ogImage,
				imageAlt: ogImageAlt,
			}}
			openGraph={{
				basic: {
					title: seoTitle,
					type: isArticle ? 'article' : 'website',
					image: ogImage,
					url: canonical,
				},
				optional: {
					siteName,
					locale: 'zh_CN',
					description: seoDescription,
				},
				image: {
					url: ogImage,
					alt: ogImageAlt,
					width: 1200,
					height: 630,
					type: 'image/png',
				},
				...(pubDate && {
					article: {
						publishedTime: pubDate.toISOString(),
						...(updatedDate && { modifiedTime: updatedDate.toISOString() }),
						...(author && { authors: [author] }),
					},
				}),
			}}
		/>
		{structuredData && (
			<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
		)}
		<link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />
	</head>
	<body>
		<div class="page">
			<nav class="top-nav">
				<div class="brand-area">
					<a class="brand" href="/">{siteName}</a>
					<p class="brand-slogan">{slogan}</p>
				</div>
				<div class="nav-links">
					<a href="/daily">日刊</a>
					<a href="/tags">标签</a>
					<a href="/search">搜索</a>
					<a href="/rss.xml">RSS</a>
					<button id="theme-toggle" class="theme-toggle" aria-label="切换深色模式">
						<svg
							class="sun-icon"
							width="18"
							height="18"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
						>
							<circle cx="12" cy="12" r="5"></circle>
							<line x1="12" y1="1" x2="12" y2="3"></line>
							<line x1="12" y1="21" x2="12" y2="23"></line>
							<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
							<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
							<line x1="1" y1="12" x2="3" y2="12"></line>
							<line x1="21" y1="12" x2="23" y2="12"></line>
							<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
							<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
						</svg>
						<svg
							class="moon-icon"
							width="18"
							height="18"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
						>
							<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
						</svg>
					</button>
				</div>
			</nav>
			<main>
				<div class:list={['content', { wide }]}>
					<slot />
				</div>
			</main>
		</div>
		<script>
			(function () {
				const themeToggle = document.getElementById('theme-toggle');
				const html = document.documentElement;

				function setTheme(theme) {
					html.setAttribute('data-theme', theme);
					localStorage.setItem('theme', theme);
				}

				function getTheme() {
					return html.getAttribute('data-theme') || 'light';
				}

				themeToggle?.addEventListener('click', () => {
					const currentTheme = getTheme();
					const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
					setTheme(newTheme);
				});
			})();
		</script>
	</body>
</html>

<style>
	:root {
		--bg-color: #f4f3ef;
		--text-color: #3a3a36;
		--text-secondary: #5c5c56;
		--text-muted: #7a7a72;
		--border-color: #ddd9d0;
		--nav-bg: rgba(244, 243, 239, 0.92);
		--link-color: #4d6b5c;
		--link-hover: #2f4a3c;
		--region-x: clamp(1rem, 2.5vw, 1.5rem);
		--region-y: 0.85rem;
	}

	[data-theme='dark'] {
		--bg-color: #1e1e1c;
		--text-color: #d8d6d0;
		--text-secondary: #a8a6a0;
		--text-muted: #8a8882;
		--border-color: #3a3a36;
		--nav-bg: rgba(30, 30, 28, 0.92);
		--link-color: #9bb8a8;
		--link-hover: #c5d9cc;
	}

	html {
		background-color: var(--bg-color);
	}

	body {
		margin: 0;
		padding: 0;
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Segoe UI',
			sans-serif;
		background: var(--bg-color);
		color: var(--text-color);
		transition: background-color 0.3s ease, color 0.3s ease;
	}

	.page {
		min-height: 100dvh;
		display: flex;
		flex-direction: column;
	}

	.top-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.85rem 0;
		width: 100%;
		box-sizing: border-box;
		border-bottom: 1px solid var(--border-color);
		background: var(--nav-bg);
		backdrop-filter: blur(8px);
		position: sticky;
		top: 0;
		z-index: 10;
	}

	.brand-area {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		padding-left: var(--region-x);
	}

	.brand {
		font-weight: 600;
		font-size: 0.95rem;
		text-decoration: none;
		color: inherit;
	}

	.brand-slogan {
		margin: 0;
		font-size: 0.72rem;
		color: var(--text-muted);
	}

	.nav-links {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.25rem;
		padding-right: var(--region-x);
	}

	.nav-links a {
		text-decoration: none;
		color: var(--link-color);
		font-size: 0.8rem;
		margin-left: 0.85rem;
		transition: color 0.2s ease;
	}

	.nav-links a:hover {
		color: var(--link-hover);
	}

	.theme-toggle {
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.5rem;
		margin-left: 1rem;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--link-color);
		transition: color 0.2s ease, transform 0.2s ease;
		border-radius: 4px;
	}

	.theme-toggle:hover {
		color: var(--link-hover);
		transform: scale(1.1);
	}

	[data-theme='dark'] .sun-icon {
		display: none;
	}

	[data-theme='light'] .moon-icon {
		display: none;
	}

	main {
		flex: 1;
		display: flex;
		flex-direction: column;
		width: 100%;
		min-height: 0;
	}

	.content {
		flex: 1;
		display: flex;
		flex-direction: column;
		width: 100%;
		min-height: 0;
		max-width: none;
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	.content.wide {
		max-width: none;
		padding: 0;
	}

	.content :global(.clip-list) {
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	.content :global(.page-header),
	.content :global(.section-header) {
		padding: var(--region-y) var(--region-x);
		border-bottom: 1px solid var(--border-color);
	}

	.content :global(.page-title) {
		padding: var(--region-y) var(--region-x);
		border-bottom: 1px solid var(--border-color);
	}

	@media (max-width: 720px) {
		.top-nav {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.65rem;
			padding: 0.75rem 0;
		}

		.brand-area {
			padding-left: var(--region-x);
		}

		.nav-links {
			width: 100%;
			justify-content: flex-start;
			padding: 0 var(--region-x);
		}

		.nav-links a {
			margin-left: 0;
			margin-right: 0.85rem;
		}

		.theme-toggle {
			margin-left: auto;
		}
	}
</style>
