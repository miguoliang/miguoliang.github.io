---
import { getAllClippings, groupByEdition, formatEditionTitle } from '../../lib/clippings';
import Layout from '../../layouts/Layout.astro';
import ClippingCard from '../../components/ClippingCard.astro';
import { buildArticleJsonLd } from '../../lib/seo';

export async function getStaticPaths() {
	const clippings = await getAllClippings();
	const editions = groupByEdition(clippings);

	return editions.map((group) => ({
		params: { slug: group.edition },
		props: { group },
	}));
}

const { group } = Astro.props;
const heading = formatEditionTitle(group.edition);
const featured = group.items[0];
// W45 GSC：/daily/2026-07-28/ 有展示无点击；页面标题保持日期，搜索标题带上当日精选。
const seo =
	group.edition === '2026-07-28' && featured
		? {
				title: 'AI 日刊 2026-07-28：Kimi K3 开放权重 1.56TB，商用许可更严 | AI 网摘',
				description:
					'当日精选：Kimi K3 开放权重约 1.56TB，并收紧商用许可——先看许可再决定能不能进生产。',
			}
		: {
				title: heading,
				description: `${heading} — 精选 AI 资讯网摘。`,
			};
const { title, description } = seo;
const siteUrl = Astro.site ?? Astro.url.origin;
const jsonLd = buildArticleJsonLd({
	title,
	description,
	url: Astro.url.href,
	pubDate: group.latestDate,
	siteUrl,
	image: new URL('/og-image.png', siteUrl).href,
	type: 'CollectionPage',
});
---

<Layout
	title={title}
	description={description}
	pubDate={group.latestDate}
	jsonLd={jsonLd}
	wide
>
	<header class="page-header" data-pagefind-body>
		<h1>{heading}</h1>
		<p class="meta">{group.items.length} 篇 · <a href="/daily">全部日刊</a></p>
	</header>

	<div class="clip-list" data-pagefind-body>
		{group.items.map((clip) => <ClippingCard clip={clip} />)}
	</div>
</Layout>

<style>
	.page-header {
		margin: 0;
	}

	h1 {
		margin: 0;
		font-size: 1.1rem;
		font-weight: 600;
		line-height: 1.35;
	}

	.meta {
		margin: 0.25rem 0 0;
		font-size: 0.75rem;
		color: var(--text-muted);
	}

	.meta a {
		color: var(--text-secondary);
		text-decoration: none;
	}

	.meta a:hover {
		text-decoration: underline;
	}
</style>
