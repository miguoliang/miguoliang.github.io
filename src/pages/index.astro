---
import {
	getAllClippings,
	groupByEdition,
	formatEditionTitle,
	editionPath,
} from '../lib/clippings';
import Layout from '../layouts/Layout.astro';
import ClippingCard from '../components/ClippingCard.astro';

const clippings = await getAllClippings();
const editions = groupByEdition(clippings);
const latestDaily = editions[0];
const recentClips = clippings.slice(0, 6);
---

<Layout
	title="AI 网摘 | 应用技巧与行业趋势"
	description="精选 AI 应用技巧与行业趋势。每日日刊，不含学术论文。"
	wide
>
	{latestDaily && (
		<section class="section">
			<div class="section-header">
				<h2>
					<a href={editionPath(latestDaily.edition)}>
						{formatEditionTitle(latestDaily.edition)}
					</a>
				</h2>
				<a href="/daily">全部日刊</a>
			</div>
			<div class="clip-list">
				{latestDaily.items.map((clip) => <ClippingCard clip={clip} />)}
			</div>
		</section>
	)}

	<section class="section">
		<div class="section-header">
			<h2>最近收录</h2>
		</div>
		<div class="clip-list">
			{recentClips.map((clip) => <ClippingCard clip={clip} showEdition />)}
		</div>
	</section>
</Layout>

<style>
	.section {
		margin-top: 0;
	}

	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		margin: 0;
	}

	.section-header h2 {
		margin: 0;
		font-size: 0.95rem;
		font-weight: 600;
	}

	.section-header h2 a {
		color: inherit;
		text-decoration: none;
	}

	.section-header h2 a:hover {
		text-decoration: underline;
	}

	.section-header > a {
		font-size: 0.75rem;
		color: var(--text-muted);
		text-decoration: none;
		white-space: nowrap;
	}

	.section-header > a:hover {
		color: var(--link-hover);
	}
</style>
