---
import Layout from '../layouts/Layout.astro';
---

<Layout title="搜索" description="搜索 AI 网摘中的文章与标签。" wide>
	<h1 class="page-title">搜索</h1>
	<div id="search"></div>
</Layout>

<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
<script src="/pagefind/pagefind-ui.js" is:inline></script>
<script is:inline>
	window.addEventListener('DOMContentLoaded', () => {
		if (typeof PagefindUI !== 'undefined') {
			new PagefindUI({
				element: '#search',
				showSubResults: true,
				resetStyles: false,
			});
		}
	});
</script>

<style>
	.page-title {
		margin: 0;
		font-size: 1rem;
		font-weight: 600;
	}

	#search {
		padding: var(--region-y) var(--region-x);
	}

	:global(#search .pagefind-ui) {
		--pagefind-ui-text: var(--text-color);
		--pagefind-ui-background: var(--bg-color);
		--pagefind-ui-border: var(--border-color);
		--pagefind-ui-tag: var(--text-secondary);
		--pagefind-ui-font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
	}

	:global(#search input) {
		background: var(--bg-color) !important;
		color: var(--text-color) !important;
		border-color: var(--border-color) !important;
	}
</style>
